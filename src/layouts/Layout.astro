---
interface Props {
	title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<nav>
			<a href={base}>Home</a>
			<a href={`${base}about`}>About</a>
		</nav>
		<main>
			<slot />
		</main>
		<footer>Built with Astro · deployed via GitHub Pages</footer>
	</body>
</html>

<style is:global>
	body {
		font-family: system-ui, sans-serif;
		max-width: 40rem;
		margin: 3rem auto;
		padding: 0 1rem;
		line-height: 1.6;
		color: #222;
	}
	nav {
		display: flex;
		gap: 1rem;
		margin-bottom: 2rem;
	}
	footer {
		margin-top: 3rem;
		font-size: 0.85rem;
		color: #777;
	}
</style>

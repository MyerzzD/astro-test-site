---
import site from '../data/site.json';
const base = import.meta.env.BASE_URL;
---

<section class="hero">
	<span class="blob b1"></span>
	<span class="blob b2"></span>
	<span class="blob b3"></span>
	<div class="wrap inner">
		<div class="copy">
			<span class="eyebrow yellow">Wisbech · Force-free · Small classes</span>
			<h1>{site.heroTitle}</h1>
			<p class="lead">{site.heroText}</p>
			<div class="actions">
				<a class="btn" href={`${base}classes/`}>See our classes</a>
				<a class="btn ghost" href="#quiz">Which class is right for us?</a>
			</div>
			<ul class="ticks">
				<li>✅ Puppies from 8 weeks</li>
				<li>✅ Max 6 dogs per class</li>
				<li>✅ Free parking at the barn</li>
			</ul>
		</div>
		<div class="art">
			<div class="photo main"><img src="https://placedog.net/720/840?id=1" alt="A happy dog looking up at its owner during training" width="720" height="840" loading="eager" /></div>
			<div class="photo small a"><img src="https://placedog.net/320/320?id=22" alt="" width="320" height="320" /></div>
			<div class="photo small b"><img src="https://placedog.net/320/320?id=30" alt="" width="320" height="320" /></div>
			<div class="badge">
				<strong>4.9★</strong>
				<span>from 200+ reviews</span>
			</div>
		</div>
	</div>
</section>

<style>
	.hero { position: relative; overflow: hidden; padding-block: clamp(2rem, 6vw, 5rem) clamp(3rem, 8vw, 6rem); }
	.b1 { width: 420px; height: 420px; background: var(--yellow); top: -160px; left: -120px; }
	.b2 { width: 300px; height: 300px; background: var(--teal); bottom: -120px; right: 25%; opacity: 0.5; }
	.b3 { width: 220px; height: 220px; background: var(--coral); top: 10%; right: -80px; opacity: 0.6; }
	.inner { position: relative; z-index: 1; display: grid; grid-template-columns: 1.1fr 1fr; gap: 3rem; align-items: center; }
	.lead { font-size: 1.25rem; color: var(--muted); max-width: 520px; }
	.actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin: 1.5rem 0; }
	.ticks { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1.4rem; font-weight: 600; color: var(--navy); }

	.art { position: relative; aspect-ratio: 6/7; max-width: 100%; }
	.photo { position: absolute; border-radius: 30px; overflow: hidden; box-shadow: var(--shadow); border: 6px solid var(--white); }
	.photo img { width: 100%; height: 100%; object-fit: cover; }
	.main { inset: 0 10% 0 0; border-radius: 45% 55% 50% 50% / 40% 40% 60% 60%; animation: float 6s ease-in-out infinite; }
	.small { width: 34%; aspect-ratio: 1; border-radius: 50%; }
	.a { right: 0; top: 8%; animation: float 5s ease-in-out infinite 0.5s; }
	.b { left: -4%; bottom: 4%; animation: float 7s ease-in-out infinite 1s; }
	.badge {
		position: absolute; right: 4%; bottom: 14%;
		background: var(--white); border-radius: 18px; padding: 0.7rem 1rem;
		box-shadow: var(--shadow); display: flex; flex-direction: column; line-height: 1.1;
		transform: rotate(-4deg);
	}
	.badge strong { font-family: var(--font-display); font-size: 1.6rem; color: var(--coral); }
	.badge span { font-size: 0.8rem; color: var(--muted); }
	@keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
	@media (prefers-reduced-motion: reduce) { .photo { animation: none; } }
	@media (max-width: 820px) {
		.inner { grid-template-columns: 1fr; }
		.art { width: 100%; max-width: 420px; margin-inline: auto; }
	}
</style>

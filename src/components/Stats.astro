---
import site from '../data/site.json';
---

<section class="stats">
	<div class="wrap grid">
		{site.stats.map((s, i) => (
			<div class:list={['stat', 'reveal', `c${i % 4}`]}>
				<strong data-count={s.value}>{s.value}</strong>
				<span>{s.label}</span>
			</div>
		))}
	</div>
</section>

<style>
	.grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
	.stat {
		border-radius: var(--radius); padding: 1.4rem 1rem; text-align: center;
		color: var(--white); transform: rotate(-1deg);
	}
	.stat:nth-child(even) { transform: rotate(1deg); }
	.stat strong { display: block; font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 2.6rem); line-height: 1; }
	.stat span { font-weight: 600; opacity: 0.9; }
	.c0 { background: var(--coral); }
	.c1 { background: var(--purple); }
	.c2 { background: var(--teal); }
	.c3 { background: var(--yellow); color: var(--navy); }
	@media (max-width: 720px) { .grid { grid-template-columns: repeat(2, 1fr); } }
</style>

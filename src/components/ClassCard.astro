---
import type { CollectionEntry } from 'astro:content';
import { dogImg, levelLabel } from '../lib/img';

interface Props { entry: CollectionEntry<'classes'> }
const { entry } = Astro.props;
const { data } = entry;
const base = import.meta.env.BASE_URL;
const low = data.spots <= 3;
---

<article class="card class-card" data-level={data.level} data-day={data.day}>
	<a href={`${base}classes/${entry.id}/`} class="img">
		<img src={dogImg(data.image, 640, 420)} alt="" width="640" height="420" loading="lazy" />
		<span class:list={['chip', data.level]}>{levelLabel[data.level]}</span>
		{low && <span class="spots">{data.spots} {data.spots === 1 ? 'space' : 'spaces'} left</span>}
	</a>
	<div class="body">
		<h3><a href={`${base}classes/${entry.id}/`}>{data.title}</a></h3>
		<p class="meta">📅 {data.day} · {data.time}</p>
		<p class="summary">{data.summary}</p>
		<div class="foot">
			<span class="price">£{data.price} <small>/ {data.weeks === 1 ? 'session' : `${data.weeks} weeks`}</small></span>
			<a class="btn teal small" href={`${base}book/?class=${entry.id}`}>Book</a>
		</div>
	</div>
</article>

<style>
	.class-card { display: flex; flex-direction: column; }
	.img { position: relative; display: block; aspect-ratio: 3/2; overflow: hidden; }
	.img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
	.class-card:hover .img img { transform: scale(1.05); }
	.chip { position: absolute; top: 0.8rem; left: 0.8rem; }
	.spots { position: absolute; top: 0.8rem; right: 0.8rem; background: var(--navy); color: var(--yellow); font-size: 0.75rem; font-weight: 800; padding: 0.25rem 0.6rem; border-radius: 999px; }
	.body { padding: 1.2rem 1.3rem 1.3rem; display: flex; flex-direction: column; flex: 1; }
	h3 a { color: inherit; text-decoration: none; }
	.meta { color: var(--muted); font-size: 0.95rem; margin-bottom: 0.4rem; }
	.summary { flex: 1; font-size: 0.98rem; }
	.foot { display: flex; align-items: center; justify-content: space-between; margin-top: 0.6rem; }
	.price { font-family: var(--font-display); font-size: 1.5rem; color: var(--navy); }
	.price small { font-family: var(--font-body); font-size: 0.85rem; color: var(--muted); }
	.btn.small { padding: 0.55rem 1.1rem; font-size: 0.95rem; }
</style>

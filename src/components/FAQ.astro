---
import site from '../data/site.json';
---

<section class="section">
	<div class="wrap faq">
		<div class="section-head reveal">
			<span class="eyebrow">Good to know</span>
			<h2>Questions we get asked a lot</h2>
		</div>
		<div class="list">
			{site.faqs.map((f, i) => (
				<details class="reveal" name="faq">
					<summary><span class="n">{String(i + 1).padStart(2, '0')}</span>{f.q}<span class="plus" aria-hidden="true">+</span></summary>
					<p>{f.a}</p>
				</details>
			))}
		</div>
	</div>
</section>

<style>
	.faq { max-width: 820px; }
	details { background: var(--white); border-radius: 18px; margin-bottom: 0.8rem; box-shadow: var(--shadow); overflow: hidden; }
	summary {
		list-style: none; cursor: pointer; display: flex; align-items: center; gap: 1rem;
		padding: 1.1rem 1.4rem; font-family: var(--font-display); font-weight: 600; font-size: 1.15rem; color: var(--navy);
	}
	summary::-webkit-details-marker { display: none; }
	.n { color: var(--coral); font-size: 0.9rem; }
	.plus { margin-left: auto; font-size: 1.6rem; line-height: 1; transition: transform 0.25s; color: var(--purple); }
	details[open] .plus { transform: rotate(45deg); }
	details p { margin: 0; padding: 0 1.4rem 1.3rem 3.6rem; color: var(--ink); }
	details[open] p { animation: fade 0.3s ease; }
	@keyframes fade { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
</style>

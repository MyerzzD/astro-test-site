---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import Testimonials from '../components/Testimonials.astro';
import CTA from '../components/CTA.astro';

const page = await getEntry('pages', 'about');
const { Content } = await render(page);
---

<Layout title={page.data.title}>
	<section class="section">
		<div class="wrap grid">
			<div class="reveal">
				<span class="eyebrow teal">About us</span>
				<h1>{page.data.heading}</h1>
				<div class="prose"><Content /></div>
			</div>
			<div class="trainer reveal">
				<img src="https://placedog.net/600/700?id=3" alt={`${site.trainer} with a dog`} width="600" height="700" loading="lazy" />
				<div class="bio">
					<h3>{site.trainer}</h3>
					<p class="role">Head trainer & founder</p>
					<p>{site.trainerBio}</p>
				</div>
			</div>
		</div>
	</section>

	<section class="section values">
		<div class="wrap">
			<h2 class="reveal">How we train</h2>
			<div class="cards">
				{[
					['🍗', 'Reward-based', 'Dogs repeat what pays off. We use food, toys and play to make the right choice the easy choice.'],
					['🔬', 'Science-led', 'Modern, evidence-based methods — no pack theory, no "alpha", no aversive tools.'],
					['👨‍👩‍👧', 'Family-friendly', 'Kids are welcome in class. Everyone who lives with the dog should be part of the training.'],
					['🎯', 'Honest', 'If a class isn\'t right for your dog, we\'ll say so and find something that is.'],
				].map(([icon, title, text], i) => (
					<div class:list={['card v', `c${i}`, 'reveal']}>
						<span class="icon">{icon}</span>
						<h3>{title}</h3>
						<p>{text}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<Testimonials />
	<CTA />
</Layout>

<style>
	.grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 3rem; align-items: start; }
	.trainer { background: var(--white); border-radius: 30px; overflow: hidden; box-shadow: var(--shadow); transform: rotate(2deg); }
	.trainer img { width: 100%; aspect-ratio: 6/7; object-fit: cover; }
	.bio { padding: 1.4rem; }
	.role { color: var(--coral); font-weight: 800; margin-top: -0.4rem; }
	.values { background: var(--white); }
	.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.4rem; }
	.v { padding: 1.6rem; }
	.icon { font-size: 2.4rem; display: block; margin-bottom: 0.6rem; }
	.c0 { background: var(--yellow); } .c1 { background: #e4e0ff; } .c2 { background: #d5f5f1; } .c3 { background: #ffe1e1; }
	@media (max-width: 820px) { .grid { grid-template-columns: 1fr; } .trainer { transform: none; } }
</style>

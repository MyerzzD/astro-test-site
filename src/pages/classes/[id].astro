---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ClassCard from '../../components/ClassCard.astro';
import { dogImg, levelLabel, bookLink } from '../../lib/img';

export async function getStaticPaths() {
	const classes = await getCollection('classes');
	return classes.map((c) => ({ params: { id: c.id }, props: { entry: c } }));
}

const base = import.meta.env.BASE_URL;
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const online = Boolean(data.bookingUrl?.trim());
const book = bookLink(entry.id, data.bookingUrl, base);
const others = (await getCollection('classes')).filter((c) => c.id !== entry.id).slice(0, 3);
---

<Layout title={`${data.title} · Fenland Paws`} description={data.summary}>
	<section class="section detail">
		<div class="wrap grid">
			<div>
				<a class="back" href={`${base}classes/`}>← All classes</a>
				<span class:list={['chip', data.level]}>{levelLabel[data.level]}</span>
				<h1>{data.title}</h1>
				<p class="lead">{data.summary}</p>
				<div class="prose"><Content /></div>
			</div>
			<aside class="card book">
				<img src={dogImg(data.image, 640, 400)} alt="" width="640" height="400" />
				<div class="body">
					<div class="price">£{data.price}<small> / {data.weeks === 1 ? 'session' : `${data.weeks}-week course`}</small></div>
					<dl>
						<dt>When</dt><dd>{data.day}, {data.time}</dd>
						<dt>Where</dt><dd>The barn, Leverington Road, Wisbech</dd>
						<dt>Spaces</dt><dd>{data.spots} left</dd>
					</dl>
					<a class="btn" href={book}>{online ? 'Book & pay online' : 'Book this class'}</a>
					{online && <p class="secure">🔒 Secure online booking · you'll get an instant confirmation</p>}
				</div>
			</aside>
		</div>
	</section>

	<section class="section others">
		<div class="wrap">
			<h2>You might also like</h2>
			<div class="row">{others.map((c) => <ClassCard entry={c} />)}</div>
		</div>
	</section>
</Layout>

<style>
	.grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 3rem; align-items: start; }
	.back { display: inline-block; text-decoration: none; font-weight: 700; margin-bottom: 1rem; }
	.chip { display: block; width: fit-content; margin-bottom: 0.8rem; }
	.lead { font-size: 1.2rem; color: var(--muted); }
	.book { position: sticky; top: 96px; }
	.book:hover { transform: none; }
	.body { padding: 1.4rem; }
	.price { font-family: var(--font-display); font-size: 2.2rem; color: var(--navy); }
	.price small { font-family: var(--font-body); font-size: 0.9rem; color: var(--muted); }
	dl { display: grid; grid-template-columns: auto 1fr; gap: 0.4rem 1rem; margin: 1rem 0 1.4rem; }
	dt { font-weight: 800; color: var(--navy); }
	dd { margin: 0; }
	.book .btn { width: 100%; justify-content: center; }
	.secure { font-size: 0.85rem; color: var(--muted); text-align: center; margin: 0.7rem 0 0; }
	.others { background: var(--white); }
	.row { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.6rem; }
	@media (max-width: 820px) { .grid { grid-template-columns: 1fr; } .book { position: static; } }
</style>
